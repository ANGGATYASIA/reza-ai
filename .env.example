# ============================================================
# Reza AI — contoh konfigurasi environment
# Salin ke .env lalu isi nilai aslinya:  cp .env.example .env
# JANGAN commit file .env ke repo.
# ============================================================

# --- Database (PostgreSQL + pgvector) ---
# Docker compose:  postgresql://reza:reza@postgres:5432/reza_ai
# Native lokal:    postgresql://reza:reza@localhost:5432/reza_ai
DATABASE_URL=postgresql://reza:reza@localhost:5432/reza_ai

# --- Redis (BullMQ + heartbeat worker) ---
# Docker compose:  redis://redis:6379
# Native lokal:    redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Kunci master untuk enkripsi AES-256-GCM (tabel Setting) ---
# WAJIB 32 byte dalam format hex (64 karakter hex).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- Autentikasi admin (Task 2) ---
# Sesi memakai opaque token di Redis (bukan JWT), jadi tidak butuh SESSION_SECRET.
# Nama issuer yang tampil di aplikasi autentikator saat enrol TOTP.
TOTP_ISSUER=Reza AI

# --- WhatsApp ---
# Direktori penyimpanan state auth Baileys (di-mount sebagai volume di compose)
WA_AUTH_DIR=/data/wa-auth
# Nomor WhatsApp owner (format lokal, tanpa +). Dipakai untuk notifikasi handoff.
OWNER_WA_NUMBER=082114812842

# --- Aplikasi web ---
PORT=3000
# URL publik dashboard. Dipakai untuk tautan di notifikasi WA handoff/draf
# ("Buka: <APP_URL>/inbox?chat=<id>") — isi dengan URL yang bisa dibuka HP.
APP_URL=http://localhost:3000

# --- Worker ---
# Interval heartbeat worker ke Redis (detik)
WORKER_HEARTBEAT_INTERVAL=15
