{
  "description": "Reza AI — WhatsApp Sales Agent untuk Grand Duta City South of Jakarta",
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "reza-ai",
  "packageManager": "pnpm@12.9.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @reza-ai/web dev",
    "dev:worker": "pnpm --filter @reza-ai/worker dev",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @reza-ai/core prisma:generate",
    "prisma:migrate": "pnpm --filter @reza-ai/core prisma:migrate",
    "test": "pnpm -r test"
  },
  "version": "0.1.0"
}